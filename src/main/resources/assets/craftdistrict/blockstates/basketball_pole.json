{
  "multipart": [
    {
      "apply": {
        "model": "craftdistrict:block/sports/basketball_pole"
      }
    },
    {
      "when": {
        "up": "false"
      },
      "apply": {
        "model": "craftdistrict:block/sports/basketball_pole_cap"
      }
    },
    {
      "when": {
        "down": "false"
      },
      "apply": {
        "model": "craftdistrict:block/sports/basketball_pole_foot"
      }
    }
  ]
}
