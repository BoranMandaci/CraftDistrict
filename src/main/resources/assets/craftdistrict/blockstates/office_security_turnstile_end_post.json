{
  "multipart": [
    { "when": { "facing": "north" }, "apply": { "model": "craftdistrict:block/office/office_security_turnstile_end_post" } },
    { "when": { "facing": "east" }, "apply": { "model": "craftdistrict:block/office/office_security_turnstile_end_post", "y": 90 } },
    { "when": { "facing": "south" }, "apply": { "model": "craftdistrict:block/office/office_security_turnstile_end_post", "y": 180 } },
    { "when": { "facing": "west" }, "apply": { "model": "craftdistrict:block/office/office_security_turnstile_end_post", "y": 270 } },
    { "when": { "facing": "north", "side_barrier": "true" }, "apply": { "model": "craftdistrict:block/office/office_security_turnstile_end_post_rail_mount" } },
    { "when": { "facing": "east", "side_barrier": "true" }, "apply": { "model": "craftdistrict:block/office/office_security_turnstile_end_post_rail_mount", "y": 90 } },
    { "when": { "facing": "south", "side_barrier": "true" }, "apply": { "model": "craftdistrict:block/office/office_security_turnstile_end_post_rail_mount", "y": 180 } },
    { "when": { "facing": "west", "side_barrier": "true" }, "apply": { "model": "craftdistrict:block/office/office_security_turnstile_end_post_rail_mount", "y": 270 } }
  ]
}
